local Players = game:GetService("Players")
local player = Players.LocalPlayer

local event =
    game.ReplicatedStorage.Nodes.Network.NetworkEvents._updateNode

local spots = {
    {
        pos = Vector3.new(2988.12, 1789.11, 3135.96),
        value = 0.108838
    },
    {
        pos = Vector3.new(3007.15, 1908.73, 2825.25),
        value = 0.0696113
    },
    {
        pos = Vector3.new(3103.75, 2.92, -231.42),
        value = 0.053784
