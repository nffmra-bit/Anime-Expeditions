local function log(message)
    pcall(function()
        print("[AE] " .. tostring(message))
    end)
end

local function getUiValue(id, fallback)
    if not UI or type(UI.GetValue) ~= "function" then
        return fallback
    end

    local ok, value = pcall(function()
        return UI.GetValue(id)
    end)

    if ok and value ~= nil then
        return value
    end

    return fallback
end

local function setUiValue(id, value)
    if not UI or type(UI.SetValue) ~= "function" then
        return false
    end

    local ok = pcall(function()
        UI.SetValue(id, value)
    end)

    return ok
end

local updateNode
local missingRemoteReported = false

local function getUpdateNode()
    if updateNode then
        return updateNode
    end

    local ok, result = pcall(function()
        local nodes = ReplicatedStorage:FindFirstChild("Nodes")
        local network = nodes and nodes:FindFirstChild("Network")
        local events = network and network:FindFirstChild("NetworkEvents")
        return events and events:FindFirstChild("_updateNode")
    end)

    if ok and result then
        updateNode = result
        return updateNode
    end

    if not missingRemoteReported then
        missingRemoteReported = true
        log("_updateNode was not found. Server actions are disabled.")
    end

    return nil
end

local function fireRemote(action, first, second, third, fourth, fifth)
    local remote = getUpdateNode()
    if not remote then
        return false
    end

    local ok, errorMessage

    if action == "FISH_CAST_REEL" then
        ok, errorMessage = pcall(function()
            remote:FireServer({ Type = "Post" }, action, first, second)
        end)
    elseif action == "FISHING_RESULT" then
        ok, errorMessage = pcall(function()
            remote:FireServer({ Type = "Post" }, action, first)
        end)
    elseif action == "REQUEST_CRAFT_CRAFTING_RECIPE" then
        ok, errorMessage = pcall(function()
            remote:FireServer({ Type = "Post" }, action, first, second, third)
        end)
    elseif action == "BANNER_SUMMON" then
        ok, errorMessage = pcall(function()
            remote:FireServer({ Type = "Post" }, action, first, second)
        end)
    elseif action == "SHOP_NODE_55_RequestNODE" then
        ok, errorMessage = pcall(function()
            remote:FireServer(
                { Type = "Post" },
                action,
                first,
                second,
                third,
                fourth,
                fifth
            )
        end)
    else
        return false
    end

    if not ok then
        log("Remote call failed: " .. tostring(errorMessage))
    end

    return ok
end

local function getRootPart()
    local character = LocalPlayer and LocalPlayer.Character
    if not character then
        return nil
    end

    local ok, root = pcall(function()
        return character:FindFirstChild("HumanoidRootPart")
    end)

    return ok and root or nil
end

local function getNearestSpot()
    local root = getRootPart()
    if not root then
        return nil
    end

    local ok, rootPosition = pcall(function()
        return root.Position
    end)

    if not ok or not rootPosition then
        return nil
    end

    local nearest
    local nearestDistance

    for _, spot in ipairs(SPOTS) do
        local distance = (rootPosition - spot.position).Magnitude
        if not nearestDistance or distance < nearestDistance then
            nearest = spot
            nearestDistance = distance
        end
    end

    return nearest
end

local function teleportToNearestSpot()
    local nearest = getNearestSpot()
    local root = getRootPart()

    if not nearest or not root then
        return false
    end

    local destination = nearest.position + Vector3.new(0, 3, 0)

    local moved = pcall(function()
        root.CFrame = CFrame.new(destination)
    end)

    if not moved then
        moved = pcall(function()
            root.Position = destination
        end)
    end

    pcall(function()
        root.Velocity = Vector3.new(0, 0, 0)
    end)

    return moved
end

local function getSelectedCraft()
    local selected = getUiValue("craft_selected", 0)

    if type(selected) == "number" then
        return CRAFT_OPTIONS[selected + 1]
    end

    if type(selected) == "string" then
        for _, option in ipairs(CRAFT_OPTIONS) do
            if option.name == selected then
                return option
            end
        end
    end

    return CRAFT_OPTIONS[1]
end

local function craftSelected()
    local option = getSelectedCraft()
    if not option then
        return false
    end

    return fireRemote(
        "REQUEST_CRAFT_CRAFTING_RECIPE",
        option.recipe,
        option.mode,
        1
    )
end

local function getSelectedShopItem()
    local selected = getUiValue("shop_selected", 0)

    if type(selected) == "number" then
        return SHOP_ITEMS[selected + 1]
    end

    if type(selected) == "string" then
        for _, item in ipairs(SHOP_ITEMS) do
            if item.name == selected then
                return item
            end
        end
    end

    return SHOP_ITEMS[1]
end

local function buyShopItem(item)
    if not item then
        return false
    end

    return fireRemote(
        "SHOP_NODE_55_RequestNODE",
        item.itemId,
        "PurchaseItem",
        "SummerShop",
        item.shopIndex,
        item.amount
    )
end

local function buySelectedShopItem()
    return buyShopItem(getSelectedShopItem())
end

local function getSelectedSummon()
    local selected = getUiValue("summon_selected", 0)

    if type(selected) == "number" then
        return SUMMON_TYPES[selected + 1] or SUMMON_TYPES[1]
    end

    if selected == "Standard" or selected == "Mini" then
        return selected
    end

    return SUMMON_TYPES[1]
end

local function getSummonAmount()
    local amount = tonumber(getUiValue("summon_amount", 1)) or 1
    amount = math.floor(amount)

    if amount < 1 then
        return 1
    end

    if amount > CONFIG.MaxSummonAmount then
        return CONFIG.MaxSummonAmount
    end

    return amount
end

local function summonSelected()
    return fireRemote(
        "BANNER_SUMMON",
        getSelectedSummon(),
        getSummonAmount()
    )
end

local function tapAntiAfkKey(key)
    if type(keypress) ~= "function" or type(keyrelease) ~= "function" then
        return false
    end

    if type(isrbxactive) == "function" then
        local activeOk, active = pcall(isrbxactive)
        if not activeOk or active ~= true then
            return false
        end
    end

    local pressed = pcall(function()
        keypress(key)
    end)

    if not pressed then
        return false
    end

    pcall(function()
        task.wait(0.02)
    end)

    local released = pcall(function()
        keyrelease(key)
    end)

    return pressed and released
end

local function buildUi()
    if not UI or type(UI.AddTab) ~= "function" then
        log("Matcha UI Binding is unavailable; script stopped safely.")
        return false
    end

    local ok, errorMessage = pcall(function()
        UI.AddTab(CONFIG.TabName, function(tab)
            local fishing = tab:Section("Fishing Event", "Left")
            fishing:Combo("shop_selected", "Shop Item", SHOP_NAMES, 0)
            fishing:Button("Buy Selected Item", function()
                buySelectedShopItem()
            end)
            fishing:Toggle("fishing_shop_auto", "Auto Buy Fishing Item", false)
            fishing:Toggle("fishing_auto", "Auto Fish", false)
            fishing:Button("TP to Nearest Fishing Spot", function()
                teleportToNearestSpot()
            end)

            local crafting = tab:Section("Crafting", "Left")
            crafting:Combo("craft_selected", "Recipe", CRAFT_NAMES, 0)
            crafting:Button("Craft Selected", function()
                craftSelected()
            end)
            crafting:Toggle("craft_auto", "Auto Craft", false)
            crafting:Toggle("craft_sprite_auto", "Auto Max Sprite Craft", false)
            crafting:Tip("Sprite Auto has priority when both craft modes are enabled.")

            local misc = tab:Section("Misc", "Right")
            misc:Toggle("anti_afk", "Anti AFK", false)

            local summon = tab:Section("Summon", "Right")
            summon:Combo("summon_selected", "Type", SUMMON_TYPES, 0)
            summon:SliderInt("summon_amount", "Amount", 1, CONFIG.MaxSummonAmount, 1)
            summon:Button("Summon Selected", function()
                summonSelected()
            end)
            summon:Toggle("summon_auto", "Auto Open", false)

        end)
    end)

    if not ok then
        log("UI creation failed: " .. tostring(errorMessage))
        return false
    end

    return true
end

local function startWorkers()
    task.spawn(function()
        while true do
            local ok, errorMessage = pcall(function()
                local fishingEnabled = getUiValue("fishing_auto", false) == true

                if not fishingEnabled then
                    task.wait(CONFIG.IdleLoopDelay)
                else
                    local spot = getNearestSpot()

                    if spot then
                        fireRemote("FISH_CAST_REEL", spot.position, spot.value)
                        task.wait(CONFIG.FishResultDelay)

                        if getUiValue("fishing_auto", false) then
                            fireRemote("FISHING_RESULT", true)
                        end
                    end

                    task.wait(CONFIG.FishLoopDelay)
                end
            end)

            if not ok then
                log("Fishing worker recovered: " .. tostring(errorMessage))
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        local nextShopPurchaseAt = 0

        while true do
            local ok, errorMessage = pcall(function()
                local enabled = getUiValue("fishing_shop_auto", false) == true

                if not enabled then
                    nextShopPurchaseAt = 0
                    task.wait(CONFIG.IdleLoopDelay)
                elseif nextShopPurchaseAt == 0 or os.clock() >= nextShopPurchaseAt then
                    buySelectedShopItem()
                    nextShopPurchaseAt = os.clock() + CONFIG.FishingShopInterval
                else
                    local remaining = nextShopPurchaseAt - os.clock()
                    task.wait(math.min(0.25, math.max(0.05, remaining)))
                end
            end)

            if not ok then
                log("Shop worker recovered: " .. tostring(errorMessage))
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        local spriteIndex = 1
        local previousSpriteEnabled = false

        while true do
            local ok, errorMessage = pcall(function()
                local spriteEnabled = getUiValue("craft_sprite_auto", false) == true
                local craftEnabled = getUiValue("craft_auto", false) == true

                if spriteEnabled then
                    if not previousSpriteEnabled then
                        spriteIndex = 1
                    end

                    local recipe = AUTO_SPRITE_RECIPES[spriteIndex]
                    if recipe then
                        fireRemote(
                            "REQUEST_CRAFT_CRAFTING_RECIPE",
                            recipe.recipe,
                            recipe.mode,
                            1
                        )

                        spriteIndex = spriteIndex + 1
                        if spriteIndex > #AUTO_SPRITE_RECIPES then
                            spriteIndex = 1
                            task.wait(CONFIG.SpriteCycleDelay)
                        else
                            task.wait(CONFIG.SpriteStepDelay)
                        end
                    else
                        spriteIndex = 1
                        task.wait(CONFIG.IdleLoopDelay)
                    end
                elseif craftEnabled then
                    spriteIndex = 1
                    craftSelected()
                    task.wait(CONFIG.CraftLoopDelay)
                else
                    spriteIndex = 1
                    task.wait(CONFIG.IdleLoopDelay)
                end

                previousSpriteEnabled = spriteEnabled
            end)

            if not ok then
                log("Crafting worker recovered: " .. tostring(errorMessage))
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        while true do
            local ok, errorMessage = pcall(function()
                if getUiValue("summon_auto", false) then
                    summonSelected()
                    task.wait(CONFIG.SummonLoopDelay)
                else
                    task.wait(CONFIG.IdleLoopDelay)
                end
            end)

            if not ok then
                log("Summon worker recovered: " .. tostring(errorMessage))
                task.wait(1)
            end
        end
    end)

    task.spawn(function()
        pcall(function()
            math.randomseed(math.floor(os.clock() * 100000))
        end)

        local nextActionAt = 0

        while true do
            local ok, errorMessage = pcall(function()
                local enabled = getUiValue("anti_afk", false) == true

                if not enabled then
                    nextActionAt = 0
                    task.wait(CONFIG.IdleLoopDelay)
                elseif nextActionAt == 0 or os.clock() >= nextActionAt then
                    local key = MOVE_KEYS[math.random(1, #MOVE_KEYS)]
                    if tapAntiAfkKey(key) then
                        nextActionAt = os.clock() + CONFIG.AntiAfkInterval
                    else
                        nextActionAt = os.clock() + CONFIG.AntiAfkCheckInterval
                    end
                else
                    local remaining = nextActionAt - os.clock()
                    task.wait(math.min(CONFIG.AntiAfkCheckInterval, math.max(0.1, remaining)))
                end
            end)

            if not ok then
                log("Anti-AFK worker recovered: " .. tostring(errorMessage))
                task.wait(1)
            end
        end
    end)

end

if buildUi() then
    startWorkers()
end
