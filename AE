    },
    {
        pos = Vector3.new(3012.41, 1617.88, 2858.05),
        value = 0.0747848
    }
}

local function getNearestSpot()
    local character = player.Character
    local root =
        character and character:FindFirstChild("HumanoidRootPart")

    if not root or #spots == 0 then
        return nil, nil, nil
    end

    local nearest = spots[1]
    local nearestIndex = 1
    local nearestDistance =
        (root.Position - spots[1].pos).Magnitude

    for i = 2, #spots do
        local distance =
            (root.Position - spots[i].pos).Magnitude

        if distance < nearestDistance then
            nearest = spots[i]
            nearestIndex = i
            nearestDistance = distance
        end
    end

    return nearest, nearestIndex, nearestDistance
end

UI.AddTab("Fishing", function(tab)

    local autoSection =
        tab:Section("Auto Fish", "Left")

    autoSection:Toggle(
        "fishing_auto",
        "Enable Auto Fish",
        false
    )

    local tpSection =
        tab:Section("Teleport", "Right")

    tpSection:Button(
        "TP to Nearest Fishing Spot",
        function()

            local nearest, index =
                getNearestSpot()

            if not nearest then
                return
            end

            local character = player.Character
            local root =
                character and character:FindFirstChild("HumanoidRootPart")

            if root then
                root.Position =
                    nearest.pos + Vector3.new(0, 3, 0)

                root.Velocity =
                    Vector3.new(0, 0, 0)
            end
        end
    )

end)

while true do
    if UI.GetValue("fishing_auto") then
        local nearest =
            getNearestSpot()

        if nearest then
            event:FireServer(
                {["Type"] = "Post"},
                "FISH_CAST_REEL",
                nearest.pos,
                nearest.value
            )

            event:FireServer(
                {["Type"] = "Post"},
                "FISHING_RESULT",
                true
            )
        end
    end

    task.wait(1)
end
